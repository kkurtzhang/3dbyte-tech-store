STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
AUTH_MFA_ENCRYPTION_KEY=replace-with-random-64-char-secret
DATABASE_URL=
DB_NAME=medusa-v2
POSTGRES_URL=

# Meilisearch Configuration
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=your-master-key
MEILISEARCH_PRODUCT_INDEX_NAME=products
MEILISEARCH_CATEGORY_INDEX_NAME=categories
MEILISEARCH_BRAND_INDEX_NAME=brands
MEILISEARCH_BLOG_INDEX_NAME=blog
MEILISEARCH_BLOG_CATEGORY_INDEX_NAME=blog_post_categories
MEILISEARCH_ADDRESS_INDEX_NAME=addresses
ADDRESS_REINDEX_ENABLED=false
ADDRESS_MANUAL_REINDEX_ENABLED=false
MEILISEARCH_LOCALITY_INDEX_NAME=localities
CATEGORY_SYNC_CRON=0 2 * * *

# OpenAddresses Configuration (Address Autocomplete Pipeline)
OPENADDRESSES_API_TOKEN=
# Optional: Override the auto-discovered download URL
# OPENADDRESSES_DOWNLOAD_URL=

# Strapi Configuration
STRAPI_API_URL=http://localhost:1337
STRAPI_API_TOKEN=your-strapi-api-token
# Secret for verifying Strapi webhooks (set to a random string)
STRAPI_WEBHOOK_SECRET=change-this-to-a-random-secret-string

# Internal AI assistant endpoints. Must match the storefront server value.
INTERNAL_API_TOKEN=replace-with-shared-random-token

# Hermes AI product draft intake. Use a dedicated random token, not an admin token.
HERMES_PRODUCT_DRAFT_TOKEN=replace-with-hermes-product-draft-token
AI_PRODUCT_DRAFT_MAX_BYTES=200000
AI_PRODUCT_DRAFT_RATE_LIMIT_PER_MINUTE=30
# Default keeps intake deterministic. Set to deepseek only when DEEPSEEK_API_KEY is configured.
AI_PRODUCT_DRAFT_NORMALIZER=deterministic
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_PRODUCT_DRAFT_MODEL_FLASH=deepseek-v4-flash
AI_PRODUCT_DRAFT_MODEL_PRO=deepseek-v4-pro
AI_PRODUCT_DRAFT_TEMPERATURE=0.1

# Google customer OAuth. Must match the storefront callback URL in Google Cloud.
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback
CUSTOMER_ACCOUNT_CONSOLIDATION_MODE=off
CUSTOMER_GOOGLE_AUTO_LINK_ENABLED=false
CUSTOMER_ACCOUNT_COORDINATION_SECRET=replace-with-random-64-char-secret

# Observability - private machine ingest over Tailscale.
# Do not use https://observe.3dbytetech.com.au or https://insights.3dbytetech.com.au for SDK traffic.
# Replace <observability-tailnet-host-or-ip> in runtime secrets only.
OTEL_EXPORTER_OTLP_ENDPOINT=http://<observability-tailnet-host-or-ip>:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
LANGFUSE_HOST=http://<observability-tailnet-host-or-ip>:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Development email testing with MailDev.
# Enabled by default when NODE_ENV=development. Set MAILDEV_ENABLED=false to
# disable locally, or MAILDEV_ENABLED=true outside development to test SMTP.
MAILDEV_ENABLED=true
MAILDEV_SMTP_HOST=192.168.0.45
MAILDEV_SMTP_PORT=1025
MAILDEV_SMTP_SECURE=false
MAILDEV_SMTP_REJECT_UNAUTHORIZED=false
MAILDEV_FROM=no-reply@3dbyte-tech.local
MAILDEV_WEB_URL=http://192.168.0.45:1080
# MAILDEV_SMTP_USER=
# MAILDEV_SMTP_PASS=
