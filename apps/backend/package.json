{
  "name": "@3dbyte-tech-store/backend",
  "version": "0.0.1",
  "description": "A starter for Medusa projects.",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "medusa build",
    "prebuild": "pnpm --filter=@3dbyte-tech-store/observability build",
    "predev": "pnpm --filter=@3dbyte-tech-store/observability build",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "seed:ai-ready-catalogue": "medusa exec ./src/scripts/seed-ai-ready-catalogue.ts",
    "seed:ai-ready-content": "medusa exec ./src/scripts/seed-ai-ready-content.ts",
    "start": "medusa start",
    "predeploy": "echo predeploy-disabled",
    "dev": "XDG_CONFIG_HOME=.medusa medusa develop",
    "pretest:unit": "pnpm --filter=@3dbyte-tech-store/observability build",
    "pretest:integration:http": "pnpm --filter=@3dbyte-tech-store/observability build",
    "pretest:integration:modules": "pnpm --filter=@3dbyte-tech-store/observability build",
    "postinstall": "patch-package",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit"
  },
  "dependencies": {
    "@3dbyte-tech-store/observability": "workspace:*",
    "@3dbyte-tech-store/shared-types": "workspace:*",
    "@3dbyte-tech-store/shared-utils": "workspace:*",
    "@medusajs/admin-sdk": "2.15.5",
    "@medusajs/admin-shared": "2.15.5",
    "@medusajs/cli": "2.15.5",
    "@medusajs/dashboard": "2.15.5",
    "@medusajs/draft-order": "2.15.5",
    "@medusajs/framework": "2.15.5",
    "@medusajs/icons": "2.15.5",
    "@medusajs/index": "2.15.5",
    "@medusajs/js-sdk": "2.15.5",
    "@medusajs/medusa": "2.15.5",
    "@medusajs/payment": "2.15.5",
    "@medusajs/payment-stripe": "2.15.5",
    "@medusajs/types": "2.15.5",
    "@medusajs/ui": "4.1.15",
    "@medusajs/utils": "2.15.5",
    "@react-email/components": "0.3.3",
    "@react-email/render": "1.1.4",
    "@strapi/client": "^1.6.0",
    "@uiw/react-json-view": "2.0.0-alpha.33",
    "ioredis": "5.8.2",
    "meilisearch": "^0.54.0",
    "node-cron": "^4.2.1",
    "nodemailer": "9.0.1",
    "react-hook-form": "^7.61.1",
    "react-router-dom": "6.30.3",
    "resend": "^6.12.3"
  },
  "devDependencies": {
    "@3dbyte-tech-store/shared-config": "workspace:*",
    "@faker-js/faker": "^10.1.0",
    "@medusajs/test-utils": "2.15.5",
    "@swc/core": "1.15.6",
    "@swc/jest": "^0.2.36",
    "@tanstack/react-query": "5.64.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "jest": "^30.2.0",
    "patch-package": "^8.0.1",
    "prop-types": "^15.8.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "6.4.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be"
}
