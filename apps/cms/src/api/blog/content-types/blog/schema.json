{
  "kind": "collectionType",
  "collectionName": "blogs",
  "info": {
    "singularName": "blog",
    "pluralName": "blogs",
    "displayName": "Blog",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "meilisearch": {
      "indexName": "blog",
      "settings": {
        "searchableAttributes": [
          "Title",
          "Content",
          "Excerpt",
          "seo_description",
          "search_keywords"
        ],
        "filterableAttributes": ["Categories"],
        "sortableAttributes": ["Title"],
        "displayedAttributes": [
          "Title",
          "Slug",
          "Content",
          "Excerpt",
          "seo_title",
          "seo_description",
          "search_keywords",
          "publishedAt"
        ]
      }
    }
  },
  "attributes": {
    "Title": {
      "type": "string",
      "required": true
    },
    "Slug": {
      "type": "uid",
      "targetField": "Title"
    },
    "Content": {
      "type": "richtext",
      "required": true
    },
    "FeaturedImage": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "Categories": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::blog-post-category.blog-post-category"
    },
    "Excerpt": {
      "type": "text",
      "required": false
    },
    "seo_title": {
      "type": "string",
      "required": false
    },
    "seo_description": {
      "type": "text",
      "required": false
    },
    "search_keywords": {
      "type": "json",
      "required": false
    },
    "open_graph_image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    }
  }
}
