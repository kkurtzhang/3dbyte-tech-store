{
  "kind": "collectionType",
  "collectionName": "campaign_placements",
  "info": {
    "singularName": "campaign-placement",
    "pluralName": "campaign-placements",
    "displayName": "Campaign Placement",
    "description": "Editorial merchandising content matched to Medusa campaign identifiers"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "CampaignIdentifier": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "Enabled": {
      "type": "boolean",
      "default": true
    },
    "Priority": {
      "type": "integer",
      "default": 0
    },
    "Eyebrow": {
      "type": "string"
    },
    "Headline": {
      "type": "string",
      "required": true
    },
    "Text": {
      "type": "text"
    },
    "Image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "CTA": {
      "displayName": "CTA",
      "type": "component",
      "repeatable": false,
      "component": "homepage.cta"
    },
    "BadgeText": {
      "type": "string"
    },
    "Theme": {
      "type": "enumeration",
      "default": "default",
      "enum": [
        "default",
        "sale",
        "new-arrival",
        "clearance"
      ]
    }
  }
}
