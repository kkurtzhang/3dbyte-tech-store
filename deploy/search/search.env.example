# 3DByte Tech Store - shared Coolify Meilisearch stack
COMPOSE_PROJECT_NAME=3dbyte-search

# Generate with: openssl rand -hex 32
# Keep this out of storefront, Medusa, Strapi, and browser-visible env vars.
MEILISEARCH_MASTER_KEY=replace-with-shared-meilisearch-master-key

# Runtime resource limits for the shared 17M-address search service.
MEILISEARCH_CPUS=1.5
MEILISEARCH_MEMORY_LIMIT=8192m
MEILISEARCH_PIDS_LIMIT=1024
MEILI_LOG_LEVEL=INFO
MEILI_HTTP_PAYLOAD_SIZE_LIMIT=200Mb
MEILI_MAX_INDEXING_MEMORY=6Gb
MEILI_MAX_INDEXING_THREADS=2
