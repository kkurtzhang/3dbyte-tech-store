# 3DByte Tech Store - Coolify production app stack
APP_ENV=production
COMPOSE_PROJECT_NAME=3dbyte-prod
COMPOSE_PROFILES=local-search

# Production owns the shared Meilisearch service and the shared address index.
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_SERVER_HOST=http://meilisearch:7700
MEILISEARCH_PRODUCT_INDEX_NAME=prod_products
MEILISEARCH_CATEGORY_INDEX_NAME=prod_categories
MEILISEARCH_BRAND_INDEX_NAME=prod_brands
MEILISEARCH_BLOG_INDEX_NAME=prod_blog
MEILISEARCH_BLOG_CATEGORY_INDEX_NAME=prod_blog_post_categories
MEILISEARCH_ADDRESS_INDEX_NAME=addresses_v1
ADDRESS_REINDEX_ENABLED=true

NEXT_PUBLIC_SITE_URL=https://store.3dbytetech.com.au
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.3dbytetech.com.au
NEXT_PUBLIC_STRAPI_URL=https://cms.3dbytetech.com.au
MEDUSA_BACKEND_URL=https://api.3dbytetech.com.au
STORE_CORS=https://store.3dbytetech.com.au
ADMIN_CORS=https://api.3dbytetech.com.au
AUTH_CORS=https://store.3dbytetech.com.au,https://api.3dbytetech.com.au

NEXT_PUBLIC_MEILISEARCH_HOST=https://search.3dbytetech.com.au
NEXT_PUBLIC_MEILISEARCH_INDEX_NAME=prod_products
NEXT_PUBLIC_MEILISEARCH_PRODUCT_INDEX_NAME=prod_products
NEXT_PUBLIC_MEILISEARCH_CATEGORY_INDEX_NAME=prod_categories
NEXT_PUBLIC_MEILISEARCH_BRAND_INDEX_NAME=prod_brands
NEXT_PUBLIC_MEILISEARCH_COLLECTION_INDEX_NAME=prod_collections
NEXT_PUBLIC_MEILISEARCH_BLOG_INDEX_NAME=prod_blog

KARRIO_TEST_MODE=false
ORDER_EMAILS_ENABLED=true
MAILDEV_ENABLED=false
OCI_BACKUP_PREFIX=prod/postgres/
PG_BACKUP_RETENTION_DAYS=14
