# 3DByte Tech Store - Coolify staging app stack
APP_ENV=staging
COMPOSE_PROJECT_NAME=3dbyte-staging
COMPOSE_PROFILES=

# Staging reads the dedicated shared Meilisearch resource.
MEILISEARCH_HOST=https://search.3dbytetech.com.au
MEILISEARCH_SERVER_HOST=https://search.3dbytetech.com.au
MEILISEARCH_PRODUCT_INDEX_NAME=stg_products
MEILISEARCH_CATEGORY_INDEX_NAME=stg_categories
MEILISEARCH_BRAND_INDEX_NAME=stg_brands
MEILISEARCH_BLOG_INDEX_NAME=stg_blog
MEILISEARCH_BLOG_CATEGORY_INDEX_NAME=stg_blog_post_categories
MEILISEARCH_PRODUCT_DOCUMENT_INDEX_NAME=stg_product_documents_public
MEILISEARCH_ADDRESS_INDEX_NAME=addresses_v1
MEILISEARCH_LOCALITY_INDEX_NAME=localities_v1
ADDRESS_REINDEX_ENABLED=false
ADDRESS_MANUAL_REINDEX_ENABLED=true

NEXT_PUBLIC_SITE_URL=https://store.staging.3dbytetech.com.au
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.staging.3dbytetech.com.au
NEXT_PUBLIC_STRAPI_URL=https://cms.staging.3dbytetech.com.au
MEDUSA_BACKEND_URL=https://api.staging.3dbytetech.com.au
MEDUSA_SERVER_BACKEND_URL=http://medusa:9000
STORE_CORS=https://store.staging.3dbytetech.com.au
ADMIN_CORS=https://api.staging.3dbytetech.com.au
AUTH_CORS=https://store.staging.3dbytetech.com.au,https://api.staging.3dbytetech.com.au

NEXT_PUBLIC_MEILISEARCH_HOST=https://search.3dbytetech.com.au
NEXT_PUBLIC_MEILISEARCH_INDEX_NAME=stg_products
NEXT_PUBLIC_MEILISEARCH_PRODUCT_INDEX_NAME=stg_products
NEXT_PUBLIC_MEILISEARCH_CATEGORY_INDEX_NAME=stg_categories
NEXT_PUBLIC_MEILISEARCH_BRAND_INDEX_NAME=stg_brands
NEXT_PUBLIC_MEILISEARCH_COLLECTION_INDEX_NAME=stg_collections
NEXT_PUBLIC_MEILISEARCH_BLOG_INDEX_NAME=stg_blog
NEXT_PUBLIC_MEILISEARCH_PRODUCT_DOCUMENT_INDEX_NAME=stg_product_documents_public

KARRIO_TEST_MODE=true
ORDER_EMAILS_ENABLED=false
MAILDEV_ENABLED=false
RESEND_FROM_EMAIL="3D Byte Tech <staging-no-reply@3dbytetech.com.au>"
SUPPORT_TICKET_INBOX_EMAIL=support@3dbytetech.com.au
INTERNAL_API_TOKEN=replace_with_staging_internal_ai_token
GOOGLE_CLIENT_ID=replace_with_staging_google_oauth_client_id
GOOGLE_CLIENT_SECRET=replace_with_staging_google_oauth_client_secret
GOOGLE_CALLBACK_URL=https://store.staging.3dbytetech.com.au/auth/google/callback
STRAPI_WEBHOOK_REVALIDATION_SECRET=replace_with_staging_strapi_revalidation_secret
STRAPI_RESEND_API_KEY=re_strapi_staging_replace_me
OCI_BACKUP_PREFIX=staging/postgres/
PG_BACKUP_RETENTION_DAYS=3
