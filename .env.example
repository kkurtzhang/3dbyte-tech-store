# 3D Byte Tech Store - Coolify / Oracle Cloud ARM64 deployment

# Compose
APP_ENV=staging
COMPOSE_PROJECT_NAME=3dbyte-staging
COMPOSE_PROFILES=
POSTGRES_SHM_SIZE=1gb

# Runtime resource limits for the 4 OCPU / 24 GB OCI Ampere host
STOREFRONT_CPUS=0.75
STOREFRONT_MEMORY_LIMIT=1024m
STOREFRONT_PIDS_LIMIT=512
MEDUSA_CPUS=1.25
MEDUSA_MEMORY_LIMIT=2048m
MEDUSA_PIDS_LIMIT=768
MEDUSA_WORKER_CPUS=0.75
MEDUSA_WORKER_MEMORY_LIMIT=1536m
MEDUSA_WORKER_PIDS_LIMIT=768
CMS_CPUS=0.75
CMS_MEMORY_LIMIT=2048m
CMS_PIDS_LIMIT=768
POSTGRES_CPUS=1.0
POSTGRES_MEMORY_LIMIT=6144m
POSTGRES_PIDS_LIMIT=512
REDIS_CPUS=0.25
REDIS_MEMORY_LIMIT=768m
REDIS_PIDS_LIMIT=256
MAILDEV_CPUS=0.25
MAILDEV_MEMORY_LIMIT=256m
MAILDEV_PIDS_LIMIT=256

# Public domains assigned in Coolify / Cloudflare
NEXT_PUBLIC_SITE_URL=https://store.example.com.au
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.example.com.au
NEXT_PUBLIC_STRAPI_URL=https://cms.example.com.au
MEDUSA_BACKEND_URL=https://api.example.com.au
MEDUSA_SERVER_BACKEND_URL=http://medusa:9000
ORDER_EMAIL_TRACKING_BASE_URL=https://store.example.com.au/track-order
STORE_CORS=https://store.example.com.au
ADMIN_CORS=https://api.example.com.au
AUTH_CORS=https://store.example.com.au,https://api.example.com.au

# PostgreSQL with pgvector
POSTGRES_DB=medusa
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-postgres-password
MEDUSA_DATABASE_NAME=medusa
STRAPI_DATABASE_NAME=strapi
# Internal Compose PostgreSQL does not expose SSL. Keep sslmode disabled if
# using these URLs outside docker-compose.yml.
MEDUSA_DATABASE_URL=postgresql://postgres:change-this-postgres-password@postgres:5432/medusa?sslmode=disable
STRAPI_DATABASE_URL=postgresql://postgres:change-this-postgres-password@postgres:5432/strapi?sslmode=disable

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_MAXMEMORY=512mb

# Medusa secrets
MEDUSA_JWT_SECRET=replace-with-random-64-char-secret
MEDUSA_COOKIE_SECRET=replace-with-random-64-char-secret
DISABLE_MEDUSA_ADMIN=false
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_live_replace_me

# Strapi secrets
STRAPI_APP_KEYS=replace-key-1,replace-key-2,replace-key-3,replace-key-4
STRAPI_API_TOKEN_SALT=replace-with-random-token-salt
STRAPI_ADMIN_JWT_SECRET=replace-with-random-admin-jwt-secret
STRAPI_TRANSFER_TOKEN_SALT=replace-with-random-transfer-token-salt
STRAPI_JWT_SECRET=replace-with-random-strapi-jwt-secret
STRAPI_ENCRYPTION_KEY=replace-with-random-encryption-key
STRAPI_API_TOKEN=replace-with-medusa-to-strapi-api-token
STRAPI_READ_TOKEN=replace-with-storefront-read-token
NEXT_PUBLIC_STRAPI_READ_TOKEN=
STRAPI_WEBHOOK_SECRET=replace-with-strapi-to-medusa-webhook-secret
STRAPI_WEBHOOK_REVALIDATION_SECRET=replace-with-strapi-to-next-revalidation-secret

# Meilisearch - app stacks use the dedicated shared search resource.
MEILISEARCH_HOST=https://search.example.com.au
MEILISEARCH_API_KEY=replace-with-meilisearch-server-indexing-key
MEILISEARCH_PRODUCT_INDEX_NAME=stg_products
MEILISEARCH_CATEGORY_INDEX_NAME=stg_categories
MEILISEARCH_BRAND_INDEX_NAME=stg_brands
MEILISEARCH_BLOG_INDEX_NAME=stg_blog
MEILISEARCH_BLOG_CATEGORY_INDEX_NAME=stg_blog_post_categories
MEILISEARCH_ADDRESS_INDEX_NAME=addresses_v1
MEILISEARCH_LOCALITY_INDEX_NAME=localities_v1
ADDRESS_REINDEX_ENABLED=false
ADDRESS_MANUAL_REINDEX_ENABLED=false
MEILISEARCH_SERVER_HOST=https://search.example.com.au
NEXT_PUBLIC_MEILISEARCH_HOST=https://search.example.com.au
NEXT_PUBLIC_MEILISEARCH_API_KEY=replace-with-meilisearch-search-only-key
NEXT_PUBLIC_MEILISEARCH_INDEX_NAME=stg_products
NEXT_PUBLIC_MEILISEARCH_PRODUCT_INDEX_NAME=stg_products
NEXT_PUBLIC_MEILISEARCH_CATEGORY_INDEX_NAME=stg_categories
NEXT_PUBLIC_MEILISEARCH_BRAND_INDEX_NAME=stg_brands
NEXT_PUBLIC_MEILISEARCH_COLLECTION_INDEX_NAME=stg_collections
NEXT_PUBLIC_MEILISEARCH_BLOG_INDEX_NAME=stg_blog

# Cloudflare R2 - S3-compatible public media storage
CLOUDFLARE_R2_ACCOUNT_ID=replace-with-cloudflare-account-id
CLOUDFLARE_R2_BUCKET_NAME=3dbyte-tech-media
CLOUDFLARE_R2_ACCESS_KEY_ID=replace-with-r2-access-key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=replace-with-r2-secret-key
CLOUDFLARE_R2_REGION=auto
CLOUDFLARE_R2_ENDPOINT=https://replace-with-cloudflare-account-id.r2.cloudflarestorage.com
CLOUDFLARE_R2_PUBLIC_HOSTNAME=media.example.com.au
CLOUDFLARE_R2_PUBLIC_URL=https://media.example.com.au
CLOUDFLARE_R2_FORCE_PATH_STYLE=true
MEDUSA_R2_ROOT_PATH=medusaUpload/
STRAPI_R2_ROOT_PATH=strapiUpload
AWS_SIGNED_URL_EXPIRES=900
NEXT_PUBLIC_CDN_SPACE_DOMAIN=media.example.com.au
NEXT_PUBLIC_SPACE_DOMAIN=media.example.com.au
NEXT_PUBLIC_SPACE_ENDPOINT=replace-with-cloudflare-account-id.r2.cloudflarestorage.com

# Stripe
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
NEXT_PUBLIC_STRIPE_KEY=pk_live_replace_me

# Karrio
KARRIO_API_URL=https://api.karrio.io
KARRIO_API_KEY=key_replace_me
KARRIO_TEST_MODE=false
KARRIO_FULFILLMENT_OPTIONS=

# Email - Medusa Resend, Strapi CMS Resend, local MailDev profile
ORDER_EMAILS_ENABLED=true
ORDER_EMAIL_STORE_NAME="3D Byte Tech"
RESEND_API_KEY=re_replace_me
RESEND_API_URL=https://api.resend.com
RESEND_FROM_EMAIL="3D Byte Tech <staging-no-reply@3dbytetech.com.au>"
STRAPI_RESEND_API_KEY=re_strapi_replace_me
MAILDEV_ENABLED=false
MAILDEV_SMTP_HOST=maildev
MAILDEV_SMTP_PORT=1025
MAILDEV_WEB_PORT=1080
MAILDEV_SMTP_SECURE=false
MAILDEV_SMTP_REJECT_UNAUTHORIZED=false
MAILDEV_FROM=no-reply@3dbyte-tech.local
MAILDEV_WEB_URL=http://maildev:1080

# Agentic commerce - external LLM APIs only
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Oracle Cloud Object Storage archive backups
OCI_CLI_AUTH=instance_principal
OCI_REGION=ap-sydney-1
OCI_NAMESPACE=replace-with-object-storage-namespace
OCI_BACKUP_BUCKET=3dbyte-tech-postgres-archive
OCI_BACKUP_PREFIX=postgres/
OCI_STORAGE_TIER=Archive
PG_BACKUP_DATABASES=medusa,strapi
PG_BACKUP_RETENTION_DAYS=14
