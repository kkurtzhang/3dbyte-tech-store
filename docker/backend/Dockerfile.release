# syntax=docker/dockerfile:1.7

ARG TARGETPLATFORM=linux/arm64
ARG PNPM_VERSION=10.32.1

FROM --platform=${TARGETPLATFORM} node:20-alpine AS builder
ARG PNPM_VERSION

RUN apk add --no-cache libc6-compat
WORKDIR /opt

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/backend/package.json apps/backend/package.json
COPY packages/observability/package.json packages/observability/package.json
COPY packages/shared-types/package.json packages/shared-types/package.json
COPY packages/shared-utils/package.json packages/shared-utils/package.json
COPY packages/shared-config/package.json packages/shared-config/package.json

RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate && pnpm install --frozen-lockfile

COPY apps/backend apps/backend
COPY packages/observability packages/observability
COPY packages/shared-types packages/shared-types
COPY packages/shared-utils packages/shared-utils
COPY packages/shared-config packages/shared-config

WORKDIR /opt/apps/backend
RUN pnpm build && \
    if [ -f .medusa/server/public/admin/index.html ] && [ ! -f .medusa/server/public/index.html ]; then \
      cp -R .medusa/server/public/admin/* .medusa/server/public/; \
    fi

FROM --platform=${TARGETPLATFORM} node:20-alpine AS runtime

RUN apk add --no-cache libc6-compat
WORKDIR /opt
RUN addgroup -g 1001 -S nodejs && \
    adduser -S medusa -u 1001

COPY --from=builder --chown=medusa:nodejs /opt/package.json /opt/pnpm-lock.yaml /opt/pnpm-workspace.yaml ./
COPY --from=builder --chown=medusa:nodejs /opt/node_modules /opt/node_modules
COPY --from=builder --chown=medusa:nodejs /opt/apps/backend/node_modules /opt/apps/backend/node_modules
COPY --from=builder --chown=medusa:nodejs /opt/apps/backend/.medusa/server /opt/apps/backend/.medusa/server
COPY --from=builder --chown=medusa:nodejs /opt/packages/observability /opt/packages/observability
COPY --from=builder --chown=medusa:nodejs /opt/packages/shared-types /opt/packages/shared-types
COPY --from=builder --chown=medusa:nodejs /opt/packages/shared-utils /opt/packages/shared-utils
COPY --from=builder --chown=medusa:nodejs /opt/packages/shared-config /opt/packages/shared-config

WORKDIR /opt/apps/backend/.medusa/server

ENV NODE_ENV=production
ENV PORT=9000
EXPOSE 9000

USER medusa
CMD ["sh", "-lc", "/opt/apps/backend/node_modules/.bin/medusa db:migrate && /opt/apps/backend/node_modules/.bin/medusa start"]
