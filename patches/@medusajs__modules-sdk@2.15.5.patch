+exports.withSessionMigrationLock = withSessionMigrationLock;
+
+// Own a private Knex pool for this invocation. Never return a possibly locked
+// connection to a pool used by another migration. The same physical session
+// acquires/releases the existing advisory key, outside any transaction.
+async function withSessionMigrationLock(knex, lockKey, migrate) {
+    let connection;
+    let locked = false;
+    let result;
+    const errors = [];
+    try {
+        connection = await knex.client.acquireConnection();
+        while (!locked) {
+            const response = await knex.raw(
+                "SELECT pg_try_advisory_lock(hashtext(?)) AS acquired", [lockKey]
+            ).connection(connection);
+            locked = response.rows[0].acquired === true;
+            // A blocking pg_advisory_lock SELECT can retain an old snapshot
+            // while waiting and deadlock a concurrent partial index builder.
+            // Sleep in JavaScript, with no open SQL statement/transaction.
+            if (!locked) {
+                await new Promise((resolve) => setTimeout(resolve, 100));
+            }
+        }
+        result = await migrate();
+    }
+    catch (error) {
+        errors.push(error);
+    }
+    finally {
+        try {
+            if (locked) {
+                const response = await knex.raw(
+                    "SELECT pg_advisory_unlock(hashtext(?)) AS released", [lockKey]
+                ).connection(connection);
+                if (response.rows[0].released !== true) {
+                    throw new Error("Migration advisory lock was not held at release");
+                }
+            }
+        }
+        catch (error) {
+            errors.push(error);
+        }
+        finally {
+            try {
+                if (connection) {
+                    await knex.client.releaseConnection(connection);
+                }
+            }
+            catch (error) {
+                errors.push(error);
+            }
+            finally {
+                try {
+                    // Closing the session also releases the lock if an acquire
+                    // or unlock response was lost. No other work uses this pool.
+                    await knex.destroy();
+                }
+                catch (error) {
+                    errors.push(error);
+                }
+            }
+        }
+    }
+    if (errors.length === 1) {
+        throw errors[0];
+    }
+    if (errors.length > 1) {
+        throw new AggregateError(errors, `Migration or advisory lock cleanup failed: ${errors.map(String).join("; ")}`, { cause: errors[0] });
+    }
+    return result;
+}
