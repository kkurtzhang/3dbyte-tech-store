diff --git a/lib/depth.js b/lib/depth.js
new file mode 100644
index 0000000000000000000000000000000000000000..a1e6df3fe7a5509642b03ff2a5da10282bb15abf
--- /dev/null
+++ b/lib/depth.js
@@ -0,0 +1,22 @@
+'use strict';
+
+// Bound every recursive walker, including callers that supply their own AST.
+const MAX_DEPTH = 100;
+
+exports.maxDepth = (options = {}) => {
+  const requested = options && options.maxDepth;
+  return typeof requested === 'number' && Number.isFinite(requested)
+    ? Math.max(0, Math.min(MAX_DEPTH, Math.floor(requested)))
+    : MAX_DEPTH;
+};
+
+exports.assertDepth = (ast, options) => {
+  const max = exports.maxDepth(options);
+  const pending = [{ node: ast, depth: 0 }];
+  while (pending.length) {
+    const { node, depth } = pending.pop();
+    if (!node || !Array.isArray(node.nodes)) continue;
+    if (depth > max) throw new RangeError(`Nesting depth exceeds maximum of ${max}`);
+    for (const child of node.nodes) pending.push({ node: child, depth: depth + 1 });
+  }
+};
